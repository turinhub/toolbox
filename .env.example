# 站点配置
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare Turnstile 验证
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITEKEY="your_turnstile_site_key"
CLOUDFLARE_TURNSTILE_SECRETKEY="your_turnstile_secret_key"

# MCP 测试工具：生产环境默认仅允许公网 HTTPS 443
MCP_TESTER_ALLOWED_PORTS="443"
# 仅在非生产自托管环境放行 RFC1918/ULA；回环、链路本地和保留地址仍禁止
MCP_TESTER_ALLOW_PRIVATE_NETWORKS="false"
# 仅限本地开发或 E2E 测试，生产环境不会启用
# MCP_TESTER_BYPASS_HUMAN_VERIFICATION="true"

# Cloudflare AI 配置
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# OpenAI 兼容服务配置 (用于 Prompt 优化工具)
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="deepseek-chat"
OPENAI_BASE_URL="https://api.deepseek.com"
